 application "Cloud Infrastructure Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Cloud_Projects
		{
			displayname = "Cloud Projects"
			success message = "Cloud Project Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Project_Name
			(
    			type = text
				displayname = "Project Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department
			(
				type = picklist	
				values  = Departments.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Lead_Engineer_Name
			(
    			type = text
				displayname = "Lead Engineer Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			E_mail
			(
    			type = email
				displayname = "E-mail"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Cloud_Provider
			(
				type = picklist
				displayname = "Cloud Provider"
				maxchar = 100
				values = {"AWS","Microsoft Azure","Google Cloud"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Allocated_Project_Budget
			(
				type = decimal
				displayname = "Allocated Project Budget"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Project_Status
			(
				type = picklist
				displayname = "Project Status"
				maxchar = 100
				values = {"Active","Frozen / Overbudget"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Cloud_Resource_Registry
		{
			displayname = "Cloud Resource Registry"
			success message = "Cloud Resource Registry Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Resource_ID
			(
    			type = text
				displayname = "Resource ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Project_Name
			(
				type = picklist	
				displayname = "Project Name"
				values  = Cloud_Projects.ID
    			displayformat = [Project_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resource_Type
			(
				type = picklist
				displayname = "Resource Type"
				maxchar = 100
				values = {"EC2 Compute Instance","S3 Storage Bucket","RDS Database","Kubernetes Cluster"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Instance_Size_Tier
			(
				type = picklist
				displayname = "Instance Size Tier"
				maxchar = 100
				values = {"t3.micro","t3.large","m5.2xlarge","db.r5.xlarge"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hourly_Cost
			(
				type = decimal
				displayname = "Hourly Cost"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Idle_CPU_Utilization
			(
				type = decimal
				displayname = "Idle CPU Utilization"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resource_Lifecycle_Status
			(
				type = picklist
				displayname = "Resource Lifecycle Status"
				maxchar = 100
				values = {"Running","Idle","Terminated"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Cloud_Resource_Requisition
		{
			displayname = "Cloud Resource Requisition"
			success message = "Cloud Resource Requisition Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Requisition_ID
			(
    			type = autonumber
				displayname = "Requisition ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Project_Name
			(
				type = picklist	
				displayname = "Project Name"
				values  = Cloud_Projects.ID
    			displayformat = [Project_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Name_Of_Requested_Person
			(
    			type = text
				displayname = "Name Of Requested Person "
	 			row = 1
	 			column = 1   
				width = medium
			)
			E_mail
			(
    			type = email
				displayname = "E-mail"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Requested_Instance_Tier
			(
				type = picklist
				displayname = "Requested Instance Tier"
				maxchar = 100
				values = {"t3.micro","t3.large","m5.2xlarge"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Justification
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Estimated_Monthly_Cost
			(
				type = decimal
				displayname = "Estimated Monthly Cost"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approval_Status
			(
				type = picklist
				displayname = "Approval Status"
				maxchar = 100
				values = {"Approved","Pending","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Departments
		{
			success message = "Department Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Department_Name
			(
    			type = text
				displayname = "Department Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department_Head
			(
    			type = text
				displayname = "Department Head"
	 			row = 1
	 			column = 1   
				width = medium
			)
			E_mail
			(
    			type = email
				displayname = "E-mail"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Overall_Quarterly_Budget
			(
				type = decimal
				displayname = "Overall Quarterly Budget "
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Resource_Cleanup_Logs
		{
			displayname = "Resource Cleanup Logs"
			success message = "Resource Cleanup Log Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Log_ID
			(
    			type = autonumber
				displayname = "Log ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resource_Name
			(
				type = picklist	
				displayname = "Resource Name"
				values  = Cloud_Resource_Registry.ID
    			displayformat = [Resource_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Project_Name
			(
    			type = text
				displayname = "Project Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Wasted_Dollars_Saved
			(
				type = decimal
				displayname = "Wasted Dollars Saved"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Taken
			(
				type = picklist
				displayname = "Action Taken"
				maxchar = 100
				values = {"Auto-Stopped Via API","Developer Notified","Manually Retained"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Execution_Time_Stamp
			(
    			type = datetime
				displayname = "Execution Time Stamp"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Departments
		{
			displayName = "All Departments"
			show all rows from Departments    
			(
				Department_Name as "Department Name"
				Department_Head as "Department Head"
				E_mail as "E-mail"
				Overall_Quarterly_Budget as "Overall Quarterly Budget "
			)
		}
		default list All_Cloud_Projects
		{
			displayName = "All Cloud Projects"
			show all rows from Cloud_Projects    
			(
				Project_Name as "Project Name"
				Department
				Lead_Engineer_Name as "Lead Engineer Name"
				E_mail as "E-mail"
				Cloud_Provider as "Cloud Provider"
				Allocated_Project_Budget as "Allocated Project Budget"
				Project_Status as "Project Status"
			)
		}
		default list All_Cloud_Resource_Registries
		{
			displayName = "All Cloud Resource Registries"
			show all rows from Cloud_Resource_Registry    
			(
				Resource_ID as "Resource ID"
				Project_Name as "Project Name"
				Resource_Type as "Resource Type"
				Instance_Size_Tier as "Instance Size Tier"
				Hourly_Cost as "Hourly Cost"
				Idle_CPU_Utilization as "Idle CPU Utilization"
				Resource_Lifecycle_Status as "Resource Lifecycle Status"
			)
		}
		default list All_Cloud_Resource_Requisitions
		{
			displayName = "All Cloud Resource Requisitions"
			show all rows from Cloud_Resource_Requisition    
			(
				Requisition_ID as "Requisition ID"
				Project_Name as "Project Name"
				Name_Of_Requested_Person as "Name Of Requested Person "
				E_mail as "E-mail"
				Requested_Instance_Tier as "Requested Instance Tier"
				Justification
				Estimated_Monthly_Cost as "Estimated Monthly Cost"
				Approval_Status as "Approval Status"
			)
		}
		default list All_Resource_Cleanup_Logs
		{
			displayName = "All Resource Cleanup Logs"
			show all rows from Resource_Cleanup_Logs    
			(
				Log_ID as "Log ID"
				Resource_Name as "Resource Name"
				Project_Name as "Project Name"
				Wasted_Dollars_Saved as "Wasted Dollars Saved"
				Action_Taken as "Action Taken"
				Execution_Time_Stamp as "Execution Time Stamp"
			)
		}
		list Running_Resources_Count_Report
		{
			displayName = "Running Resources Count"
			show all rows from Cloud_Resource_Registry  [Resource_Lifecycle_Status == "Running"]  
			(
				Resource_ID as "Resource ID"
				Resource_Type as "Resource Type"
				Instance_Size_Tier as "Instance Size Tier"
				Hourly_Cost as "Hourly Cost"
				Resource_Lifecycle_Status as "Resource Lifecycle Status"
			)
		}
		list Idle_Resources_Report
		{
			displayName = "Idle Resources Report"
			show all rows from Cloud_Resource_Registry  [Resource_Lifecycle_Status == "Idle"]  
			(
				Resource_ID as "Resource ID"
				Project_Name as "Project Name"
				Resource_Type as "Resource Type"
				Instance_Size_Tier as "Instance Size Tier"
				Hourly_Cost as "Hourly Cost"
				Idle_CPU_Utilization as "Idle CPU Utilization"
				Resource_Lifecycle_Status as "Resource Lifecycle Status"
				custom action "Stop Idle Instance"
				(
	  			workflow = Stop_Idle_Instance
				column header = "Stop Idle Instance"
				success message = "Instance stopped successfully."
				confirmation before execution
				(
					message for individual record = "Are you sure you want to stop this idle instance?"
					confirm button text = "Confirm Stop"		
					cancel button text = "Cancel"
				)
				)
			)
		}
		list Active_Resources_Report
		{
			displayName = "Active Resources Report"
			show all rows from Cloud_Resource_Registry  [Resource_Lifecycle_Status == "Running"]  
			(
				Resource_ID as "Resource ID"
				Project_Name as "Project Name"
				Resource_Type as "Resource Type"
				Instance_Size_Tier as "Instance Size Tier"
				Hourly_Cost as "Hourly Cost"
				Idle_CPU_Utilization as "Idle CPU Utilization"
				Resource_Lifecycle_Status as "Resource Lifecycle Status"
			)
		}
	}
	pages
	{
		page Cloud_Infrastructure_Executive_Dashboard
		{
			displayname = "Cloud Infrastructure Executive Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Running_Resources_Count_.stat.outlined.comfortable'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n    borderColor = '#F0F0F0'\n    borderWidth = '1px'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '8px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '24px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#575757'\n\tsize = '13px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Running Resources'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='8px'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#1C1C1C'\n\tsize = '30px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'Resource_Lifecycle_Status == &quot;Running&quot;'\n\t  value = 'thisapp.Cloud_Resource_Registry.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='8px'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#575757'\n\tsize = '12px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Total count of active resources'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Resource_Cleanup_Logs.Wasted_Dollars_Saved.sum'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Cloud Waste Saved ($)'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Cloud_Projects.Allocated_Project_Budget.sum'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Allocated Budget ($)'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Department-wise Budget Allocation'\n\n\ttype = 'Pie'\n\txtitle = 'Department'\n\tytitle = 'Allocated Project Budget'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Cloud_Projects'\n\txfield = 'Department.Department_Name'\n\tyfields = 'sum:Allocated_Project_Budget'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Idle_Resources_Report'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_EditRec = 'false'\n\t\t\t\t\tzc_DelRec = 'false'\n\t\t\t\t\tzc_DuplRec = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 1'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Resource_Cleanup_Logs'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_EditRec = 'false'\n\t\t\t\t\tzc_DelRec = 'false'\n