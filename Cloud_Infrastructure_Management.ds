		 functions
		 {
			 Deluge
			 {
				 void Stop_Idle_Instance(int rec_id)
                 {
                 	// Fetch the target resource record using the passed record ID
                 	resRecord = Cloud_Resource_Registry[ID == rec_id];
                 	// Webhook testing URL (Generate a free endpoint at https://webhook.site)
                 	apiUrl = "https://webhook.site/YOUR-UNIQUE-WEBHOOK-ID";
                 	headers = Map();
                 	headers.put("Content-Type","application/json");
                 	// Construct JSON payload
                 	payloadMap = Map();
                 	payloadMap.put("resource_id",resRecord.Resource_ID);
                 	payloadMap.put("action","STOP_INSTANCE");
                 	payloadMap.put("requested_by",zoho.adminuser);
                 	// Dispatch outbound REST API call
                 	response = invokeurl
                 	[
                 		url :apiUrl
                 		type :POST
                 		parameters:payloadMap.toString()
                 		headers:headers
                 	];
                 	// Update resource status in Registry
                 	resRecord.Resource_Lifecycle_Status="Terminated";
                 	// Insert entry into audit logs without commas
                 	insert into Resource_Cleanup_Logs
                 	[
                 		Resource_Name=resRecord.ID
                 		Project_Name=resRecord.Project_Name.Project_Name
                 		Wasted_Dollars_Saved=resRecord.Hourly_Cost * 720
                 		Action_Taken="Auto-Stopped Via API"
                 		Execution_Time_Stamp=zoho.currenttime
                 		Added_User=zoho.loginuser
                 	]
                 }
			 }
		 }


		workflow
		{
		form
		{
			Dynamic_Hourly_Cost_Calcu as "Dynamic Hourly Cost Calculation"
			{
				type =  form
				form = Cloud_Resource_Registry

				record event = on add or edit

				on user input of Instance_Size_Tier
				{
					actions 
					{
						custom deluge script
						(
											// Map instance size tier to hourly pricing rate
										if(input.Instance_Size_Tier == "t3.micro")
										{
											input.Hourly_Cost = 0.0104;
										}
										else if(input.Instance_Size_Tier == "t3.large")
										{
											input.Hourly_Cost = 0.0832;
										}
										else if(input.Instance_Size_Tier == "m5.2xlarge")
										{
											input.Hourly_Cost = 0.3840;
										}
										else if(input.Instance_Size_Tier == "db.r5.xlarge")
										{
											input.Hourly_Cost = 0.4800;
										}
						)
					}
				}

			}
			Dynamic_Requisition_Cost_ as "Dynamic Requisition Cost Calculation"
			{
				type =  form
				form = Cloud_Resource_Requisition

				record event = on add or edit

				on user input of Requested_Instance_Tier
				{
					actions 
					{
						custom deluge script
						(
											hourlyRate = 0.0;
										if(input.Requested_Instance_Tier == "t3.micro")
										{
											hourlyRate = 0.0104;
										}
										else if(input.Requested_Instance_Tier == "t3.large")
										{
											hourlyRate = 0.0832;
										}
										else if(input.Requested_Instance_Tier == "m5.2xlarge")
										{
											hourlyRate = 0.3840;
										}
										// Compute projected monthly cost (Assuming 720 operating hours / month)
										input.Estimated_Monthly_Cost = hourlyRate * 720;
						)
					}
				}

			}
			Pre_Validation_Budget_Con as "Pre-Validation Budget Control"
			{
				type =  form
				form = Cloud_Resource_Requisition

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Retrieve parent project record details
										projectRec = Cloud_Projects[ID == input.Project_Name];
										if(projectRec != null)
										{
											// Check if the requested cost exceeds the project budget
											if(input.Estimated_Monthly_Cost > projectRec.Allocated_Project_Budget)
											{
												alert "Budget Violation: Requested instance estimated cost ($" + input.Estimated_Monthly_Cost.round(2) + ") exceeds total project budget ($" + projectRec.Allocated_Project_Budget + ").";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Auto_Provision_Resource_o as "Auto-Provision Resource on Approval"
			{
				type =  form
				form = Cloud_Resource_Requisition

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Approval_Status == "Approved")
										{
											hRate = 0.0;
											if(input.Requested_Instance_Tier == "t3.micro")
											{
												hRate = 0.0104;
											}
											else if(input.Requested_Instance_Tier == "t3.large")
											{
												hRate = 0.0832;
											}
											else if(input.Requested_Instance_Tier == "m5.2xlarge")
											{
												hRate = 0.3840;
											}
											resID = "i-auto-" + input.Requisition_ID;
											insert into Cloud_Resource_Registry
											[
												Resource_ID=resID
												Project_Name=input.Project_Name
												Resource_Type="EC2 Compute Instance"
												Instance_Size_Tier=input.Requested_Instance_Tier
												Hourly_Cost=hRate
												Idle_CPU_Utilization=100.0
												Resource_Lifecycle_Status="Running"
												Added_User=zoho.loginuser
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			Weekly_Idle_Resource_Swee as "Weekly Idle Resource Sweeper"
			{
				type =  schedule
				start = "2026-10-16 20:00:00"
				frequency = weekly
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all active resources with CPU utilization below 5%
										idleAssets = Cloud_Resource_Registry[Idle_CPU_Utilization < 5.0 && Resource_Lifecycle_Status == "Running"];
										for each  asset in idleAssets
										{
											// Calculate estimated waste saved (Assuming 120 idle hours logged)
											wasteSaved = asset.Hourly_Cost * 120;
											// Update asset lifecycle status
											asset.Resource_Lifecycle_Status="Idle";
											// Create an audit entry in Resource_Cleanup_Logs without commas
											insert into Resource_Cleanup_Logs
											[
												Resource_Name=asset.ID
												Project_Name=asset.Project_Name
												Wasted_Dollars_Saved=wasteSaved
												Action_Taken="Developer Notified"
												Execution_Time_Stamp=zoho.currenttime
												Added_User=zoho.loginuser
											]
										}
					)
					}
				}
			}
		}




		functions
		{
			Stop_Idle_Instance as "Stop Idle Instance"
			{
				type =  functions
				form = Cloud_Resource_Registry
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						// Fetch the selected record from Cloud_Resource_Registry
										selectedRecord = Cloud_Resource_Registry[ID == input.ID];
										// Check if the record exists and is in Idle status
										if(selectedRecord != null && selectedRecord.Resource_Lifecycle_Status == "Idle")
										{
											// Call the custom function to stop the instance (void function)
											thisapp.Stop_Idle_Instance(selectedRecord.ID);
											// Update the record status to Terminated after successful stop
											selectedRecord.Resource_Lifecycle_Status="Terminated";
											info "Instance stopped successfully";
										}
										else
										{
											info "Selected record is not idle or does not exist";
										}
					)
					}
				}
			}
		}
	}
