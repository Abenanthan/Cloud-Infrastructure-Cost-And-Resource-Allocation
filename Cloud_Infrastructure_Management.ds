 application "Cloud Infrastructure Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Cloud_Projects
		{
			displayname = "Cloud Projects"
			success message = "Cloud Project Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Project_Name
			(
    			type = text
				displayname = "Project Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department
			(
				type = picklist	
				values  = Departments.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Lead_Engineer_Name
			(
    			type = text
				displayname = "Lead Engineer Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			E_mail
			(
    			type = email
				displayname = "E-mail"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Cloud_Provider
			(
				type = picklist
				displayname = "Cloud Provider"
				maxchar = 100
				values = {"AWS","Microsoft Azure","Google Cloud"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Allocated_Project_Budget
			(
				type = decimal
				displayname = "Allocated Project Budget"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Project_Status
			(
				type = picklist
				displayname = "Project Status"
				maxchar = 100
				values = {"Active","Frozen / Overbudget"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Cloud_Resource_Registry
		{
			displayname = "Cloud Resource Registry"
			success message = "Cloud Resource Registry Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Resource_ID
			(
    			type = text
				displayname = "Resource ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Project_Name
			(
				type = picklist	
				displayname = "Project Name"
				values  = Cloud_Projects.ID
    			displayformat = [Project_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Resource_Type
			(
				type = picklist
				displayname = "Resource Type"
				maxchar = 100
				values = {"EC2 Compute Instance","S3 Storage Bucket","RDS Database","Kubernetes Cluster"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Instance_Size_Tier
			(
				type = picklist
				displayname = "Instance Size Tier / Resource Configuration"
				maxchar = 100
				values = {"t3.micro","t3.large","m5.2xlarge","db.r5.xlarge","db.r5.large","S3 Standard – 50 GB","S3 Standard – 100 GB","S3 Standard – 500 GB","EKS – Small","EKS – Medium","EKS – Large"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hourly_Cost
			(
				type = decimal
				displayname = "Hourly Cost"
				decimalplace = 4
	 			row = 1
	 			column = 1   
				width = medium
			)
			Idle_CPU_Utilization
			(
				type = decimal
				displayname = "CPU Utilization"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resource_Lifecycle_Status
			(
				type = picklist
				displayname = "Resource Lifecycle Status"
				maxchar = 100
				values = {"Running","Idle","Terminated"}
				initial value = "Running"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Cloud_Resource_Requisition
		{
			displayname = "Cloud Resource Requisition"
			success message = "Cloud Resource Requisition Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Requisition_ID
			(
    			type = autonumber
				displayname = "Requisition ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Project_Name
			(
				type = picklist	
				displayname = "Project Name"
				values  = Cloud_Projects.ID
    			displayformat = [Project_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Name_Of_Requested_Person
			(
    			type = text
				displayname = "Name Of Requested Person "
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have E_mail
			(
    			type = email
				displayname = "E-mail"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Requested_Instance_Tier
			(
				type = picklist
				displayname = "Requested Instance Tier"
				maxchar = 100
				values = {"t3.micro","t3.large","m5.2xlarge"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Justification
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Estimated_Monthly_Cost
			(
				type = decimal
				displayname = "Estimated Monthly Cost"
				decimalplace = 4
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approval_Status
			(
				type = picklist
				displayname = "Approval Status"
				maxchar = 100
				values = {"Approved","Pending","Rejected"}
				initial value = "Pending"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Departments
		{
			success message = "Department Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Department_Name
			(
    			type = text
				displayname = "Department Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department_Head
			(
    			type = text
				displayname = "Department Head"
	 			row = 1
	 			column = 1   
				width = medium
			)
			E_mail
			(
    			type = email
				displayname = "E-mail"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Overall_Quarterly_Budget
			(
				type = decimal
				displayname = "Overall Quarterly Budget "
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department_Contact_Details
			(
				type = grid
				displayname = "Department Contact Details"
				Employee_Name
				(
    				type = text
					displayname = "Employee Name"
					width = medium
				)
				Employee_Email
				(
    				type = email
					displayname = "Employee Email"
					maxchar = 80
					width = medium
					personal data = true
				)
				Employee_Phone_Number
				(
    				type = phonenumber
					displayname = "Employee Phone Number"
					width = medium
					personal data = true
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Resource_Cleanup_Logs
		{
			displayname = "Resource Cleanup Logs"
			success message = "Resource Cleanup Log Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Log_ID
			(
    			type = autonumber
				displayname = "Log ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resource_Name
			(
				type = picklist	
				displayname = "Resource Name"
				values  = Cloud_Resource_Registry.ID
    			displayformat = [Resource_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Project_Name
			(
    			type = text
				displayname = "Project Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Wasted_Dollars_Saved
			(
				type = decimal
				displayname = "Wasted Dollars Saved"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Taken
			(
				type = picklist
				displayname = "Action Taken"
				maxchar = 100
				values = {"Auto-Stopped Via API","Developer Notified","Manually Retained"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Execution_Time_Stamp
			(
    			type = datetime
				displayname = "Execution Time Stamp"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Departments
		{
			displayName = "All Departments"
			show all rows from Departments    
			(
				Department_Name as "Department Name"
				Department_Head as "Department Head"
				E_mail as "E-mail"
				Overall_Quarterly_Budget as "Overall Quarterly Budget "
				Department_Contact_Details.Employee_Name as "Department Contact Details"
			)
		}
		default list All_Cloud_Projects
		{
			displayName = "All Cloud Projects"
			show all rows from Cloud_Projects    
			(
				Project_Name as "Project Name"
				Department
				Lead_Engineer_Name as "Lead Engineer Name"
				E_mail as "E-mail"
				Cloud_Provider as "Cloud Provider"
				Allocated_Project_Budget as "Allocated Project Budget"
				Project_Status as "Project Status"
			)
		}
		default list All_Cloud_Resource_Registries
		{
			displayName = "All Cloud Resource Registries"
			show all rows from Cloud_Resource_Registry    
			(
				Resource_ID as "Resource ID"
				Project_Name as "Project Name"
				Resource_Type as "Resource Type"
				Instance_Size_Tier as "Instance Size Tier / Resource Configuration"
				Hourly_Cost as "Hourly Cost"
				Idle_CPU_Utilization as "CPU Utilization"
				Resource_Lifecycle_Status as "Resource Lifecycle Status"
			)
			custom actions
			(
				"Test Stop Function"
				(
	  			workflow = Test_Stop_Function
				show action in edit record menu = true
				)
			)
		}
		default list All_Cloud_Resource_Requisitions
		{
			displayName = "All Cloud Resource Requisitions"
			show all rows from Cloud_Resource_Requisition    
			(
				Requisition_ID as "Requisition ID"
				Project_Name as "Project Name"
				Name_Of_Requested_Person as "Name Of Requested Person "
				E_mail as "E-mail"
				Requested_Instance_Tier as "Requested Instance Tier"
				Justification
				Estimated_Monthly_Cost as "Estimated Monthly Cost"
				Approval_Status as "Approval Status"
			)
		}
		default list All_Resource_Cleanup_Logs
		{
			displayName = "All Resource Cleanup Logs"
			show all rows from Resource_Cleanup_Logs    
			(
				Log_ID as "Log ID"
				Resource_Name as "Resource Name"
				Project_Name as "Project Name"
				Wasted_Dollars_Saved as "Wasted Dollars Saved"
				Action_Taken as "Action Taken"
				Execution_Time_Stamp as "Execution Time Stamp"
			)
		}
		list Running_Resources_Count_Report
		{
			displayName = "Running Resources Count"
			show all rows from Cloud_Resource_Registry  [Resource_Lifecycle_Status == "Running"]  
			(
				Resource_ID as "Resource ID"
				Resource_Type as "Resource Type"
				Instance_Size_Tier as "Instance Size Tier / Resource Configuration"
				Hourly_Cost as "Hourly Cost"
				Resource_Lifecycle_Status as "Resource Lifecycle Status"
			)
		}
		list Idle_Resources_Report
		{
			displayName = "Idle Resources Report"
			show all rows from Cloud_Resource_Registry  [Resource_Lifecycle_Status == "Idle"]  
			(
				Resource_ID as "Resource ID"
				Project_Name as "Project Name"
				Resource_Type as "Resource Type"
				Instance_Size_Tier as "Instance Size Tier / Resource Configuration"
				Hourly_Cost as "Hourly Cost"
				Idle_CPU_Utilization as "CPU Utilization"
				Resource_Lifecycle_Status as "Resource Lifecycle Status"
				custom action "Stop Idle Instance"
				(
	  			workflow = Stop_Idle_Instance
				column header = "Stop Idle Instance"
				success message = "Instance stopped successfully."
				confirmation before execution
				(
					message for individual record = "Are you sure you want to stop this idle instance?"
					confirm button text = "Confirm Stop"		
					cancel button text = "Cancel"
				)
				)
			)
		}
		list Active_Resources_Report
		{
			displayName = "Active Resources Report"
			show all rows from Cloud_Resource_Registry  [Resource_Lifecycle_Status == "Running"]  
			(
				Resource_ID as "Resource ID"
				Project_Name as "Project Name"
				Resource_Type as "Resource Type"
				Instance_Size_Tier as "Instance Size Tier / Resource Configuration"
				Hourly_Cost as "Hourly Cost"
				Idle_CPU_Utilization as "CPU Utilization"
				Resource_Lifecycle_Status as "Resource Lifecycle Status"
			)
		}
	}
	pages
	{
		page Cloud_Infrastructure_Executive_Dashboard
		{
			displayname = "Cloud Infrastructure Executive Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Running_Resources_Count_.stat.outlined.comfortable'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n    borderColor = '#F0F0F0'\n    borderWidth = '1px'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '8px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '24px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#575757'\n\tsize = '13px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Running Resources'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='8px'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#1C1C1C'\n\tsize = '30px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'Resource_Lifecycle_Status == &quot;Running&quot;'\n\t  value = 'thisapp.Cloud_Resource_Registry.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='8px'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#575757'\n\tsize = '12px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Total count of active resources'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Resource_Cleanup_Logs.Wasted_Dollars_Saved.sum'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Cloud Waste Saved ($)'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Cloud_Projects.Allocated_Project_Budget.sum'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Allocated Budget ($)'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Department-wise Budget Allocation'\n\n\ttype = 'Pie'\n\txtitle = 'Department'\n\tytitle = 'Allocated Project Budget'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Cloud_Projects'\n\txfield = 'Department.Department_Name'\n\tyfields = 'sum:Allocated_Project_Budget'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Idle_Resources_Report'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_EditRec = 'false'\n\t\t\t\t\tzc_DelRec = 'false'\n\t\t\t\t\tzc_DuplRec = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 1'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Resource_Cleanup_Logs'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_EditRec = 'false'\n\t\t\t\t\tzc_DelRec = 'false'\n\t\t\t\t\tzc_DuplRec = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}


		 functions
		 {
			 Deluge
			 {
				 void Stop_Idle_Instance(int rec_id)
                 {
                 	resRecord = Cloud_Resource_Registry[ID == rec_id];
                 	if(resRecord.ID != null)
                 	{
                 		if(resRecord.Resource_Lifecycle_Status == "Idle" && resRecord.Resource_Type != "S3 Storage Bucket")
                 		{
                 			// Update resource status
                 			resRecord.Resource_Lifecycle_Status="Terminated";
                 			// Send email notification
                 			sendmail
                 			[
                 				from :zoho.adminuserid
                 				to :"abenanthan.p.2024.cse@rajalakshmi.edu.in"
                 				subject :"Cloud Resource Terminated"
                 				message :"Resource ID: " + resRecord.Resource_ID + "<br>Project: " + resRecord.Project_Name.Project_Name + "<br>Status: Terminated"
                 			]
                 			// Create cleanup log
                 			insert into Resource_Cleanup_Logs
                 			[
                 				Resource_Name=resRecord.ID
                 				Project_Name=resRecord.Project_Name.Project_Name
                 				Wasted_Dollars_Saved=resRecord.Hourly_Cost * 720
                 				Action_Taken="Auto-Stopped"
                 				Execution_Time_Stamp=zoho.currenttime
                 				Added_User=zoho.loginuser
                 			]
                 			info "Resource terminated successfully.";
                 		}
                 		else
                 		{
                 			info "Resource is not eligible for this action.";
                 		}
                 	}
                 	else
                 	{
                 		info "Resource not found.";
                 	}
                 }
			 }
		 }


		workflow
		{
		form
		{
			Dynamic_Hourly_Cost_Calcu as "Dynamic Hourly Cost Calculation"
			{
				type =  form
				form = Cloud_Resource_Registry

				record event = on add or edit

				on user input of Instance_Size_Tier
				{
					actions 
					{
						custom deluge script
						(
											// DS-01: Calculate estimated hourly cost based on resource type and configuration
										// EC2 Compute Instance
										if(input.Resource_Type == "EC2 Compute Instance")
										{
											if(input.Instance_Size_Tier == "t3.micro")
											{
												input.Hourly_Cost = 0.0104;
											}
											else if(input.Instance_Size_Tier == "t3.large")
											{
												input.Hourly_Cost = 0.0832;
											}
											else if(input.Instance_Size_Tier == "m5.2xlarge")
											{
												input.Hourly_Cost = 0.3840;
											}
										}
										// RDS Database
										else if(input.Resource_Type == "RDS Database")
										{
											if(input.Instance_Size_Tier == "db.r5.large")
											{
												input.Hourly_Cost = 0.2400;
											}
											else if(input.Instance_Size_Tier == "db.r5.xlarge")
											{
												input.Hourly_Cost = 0.4800;
											}
										}
										// S3 Storage Bucket
										else if(input.Resource_Type == "S3 Storage Bucket")
										{
											if(input.Instance_Size_Tier == "S3 Standard - 50 GB")
											{
												input.Hourly_Cost = 0.0016;
											}
											else if(input.Instance_Size_Tier == "S3 Standard - 100 GB")
											{
												input.Hourly_Cost = 0.0032;
											}
											else if(input.Instance_Size_Tier == "S3 Standard - 500 GB")
											{
												input.Hourly_Cost = 0.0160;
											}
										}
										// Kubernetes Cluster
										else if(input.Resource_Type == "Kubernetes Cluster")
										{
											if(input.Instance_Size_Tier == "EKS - Small")
											{
												input.Hourly_Cost = 0.1832;
											}
											else if(input.Instance_Size_Tier == "EKS - Medium")
											{
												input.Hourly_Cost = 0.2664;
											}
											else if(input.Instance_Size_Tier == "EKS - Large")
											{
												input.Hourly_Cost = 0.8680;
											}
										}
						)
					}
				}

			}
			Dynamic_Requisition_Cost_ as "Dynamic Requisition Cost Calculation"
			{
				type =  form
				form = Cloud_Resource_Requisition

				record event = on add or edit

				on user input of Requested_Instance_Tier
				{
					actions 
					{
						custom deluge script
						(
											hourlyRate = 0.0;
										if(input.Requested_Instance_Tier == "t3.micro")
										{
											hourlyRate = 0.0104;
										}
										else if(input.Requested_Instance_Tier == "t3.large")
										{
											hourlyRate = 0.0832;
										}
										else if(input.Requested_Instance_Tier == "m5.2xlarge")
										{
											hourlyRate = 0.3840;
										}
										// Compute projected monthly cost (Assuming 720 operating hours / month)
										input.Estimated_Monthly_Cost = hourlyRate * 720;
						)
					}
				}

			}
			Pre_Validation_Budget_Con as "Pre-Validation Budget Control"
			{
				type =  form
				form = Cloud_Resource_Requisition

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Retrieve parent project record details
										projectRec = Cloud_Projects[ID == input.Project_Name];
										if(projectRec != null)
										{
											// Check whether the selected project is Active
											if(projectRec.Project_Status != "Active")
											{
												alert "Project is Frozen / Overbudget. Resource requisitions cannot be submitted.";
												cancel submit;
											}
											// Check if requested cost exceeds project budget
											else if(input.Estimated_Monthly_Cost > projectRec.Allocated_Project_Budget)
											{
												alert "Budget Violation: Requested instance estimated cost ($" + input.Estimated_Monthly_Cost.round(2) + ") exceeds total project budget ($" + projectRec.Allocated_Project_Budget + ").";
												cancel submit;
											}
										}
										else
										{
											alert "Selected project could not be found.";
											cancel submit;
										}
						)
					}
				}

			}
			Auto_Provision_Resource_o as "Auto-Provision Resource on Approval"
			{
				type =  form
				form = Cloud_Resource_Requisition

				record event = on add or edit
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Approval_Status == "Approved")
										{
											hRate = 0.0;
											if(input.Requested_Instance_Tier == "t3.micro")
											{
												hRate = 0.0104;
											}
											else if(input.Requested_Instance_Tier == "t3.large")
											{
												hRate = 0.0832;
											}
											else if(input.Requested_Instance_Tier == "m5.2xlarge")
											{
												hRate = 0.3840;
											}
											resID = "i-auto-" + input.Requisition_ID;
											insert into Cloud_Resource_Registry
											[
												Resource_ID=resID
												Project_Name=input.Project_Name
												Resource_Type="EC2 Compute Instance"
												Instance_Size_Tier=input.Requested_Instance_Tier
												Hourly_Cost=hRate
												Idle_CPU_Utilization=100.0
												Resource_Lifecycle_Status="Running"
												Added_User=zoho.loginuser
											]
										}
						)
					}
				}

			}
			Email_When_Stopped as "Email_When_Stopped"
			{
				type =  form
				form = Cloud_Resource_Registry

				record event = on edit

				on success
				{
					actions  (Resource_Lifecycle_Status == "Terminated")
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.adminuserid","zoho.loginuserid","abenanthan.p.2024.cse@rajalakshmi.edu.in"
							subject : "Idle Cloud Instance Stopped - Resource Cleanup Alert"
							message : "<div>${zoho.loginuserid} has updated a record in form Cloud Resource Registry<br></div><div><br></div><p><span>Hello,</span><br></p><p><span>An idle cloud resource has been marked as Terminated in the Cloud Infrastructure Management System.</span><br></p><p><b><span>Resource Details</span></b><br></p><ul><li><p style=\"margin-top: 0px;\"><span>Resource ID: [Insert Resource_ID]</span><br></p></li><li><p style=\"margin-top: 0px;\"><span>Project Name: [Insert Project_Name]</span><br></p></li><li><p style=\"margin-top: 0px;\"><span>Resource Type: [Insert Resource_Type]</span><br></p></li><li><p style=\"margin-top: 0px;\"><span>Instance Tier: [Insert Instance_Size_Tier]</span><br></p></li><li><p style=\"margin-top: 0px;\"><span>Hourly Cost: [Insert Hourly_Cost]</span><br></p></li><li><p style=\"margin-top: 0px;\"><span>Current Status: [Insert Resource_Lifecycle_Status]</span><br></p></li></ul><p><span>Please review the resource cleanup logs for further details.</span><br></p><p><br></p><div><span>Regards,</span><br></div><div><span>Cloud Infrastructure Management System</span><br></div><p><br></p><div><br></div>"
						)
					}
				}

			}
			Validate_Project_Budget_u as "Validate Project Budget using Department budget"
			{
				type =  form
				form = Cloud_Projects

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Get the selected department
										deptRecord = Departments[ID == input.Department];
										// Calculate existing project allocations
										totalAllocated = 0;
										for each  project in Cloud_Projects
										{
											if(project.Department == input.Department)
											{
												totalAllocated = totalAllocated + project.Allocated_Project_Budget;
											}
										}
										// Calculate remaining department budget
										remainingBudget = deptRecord.Overall_Quarterly_Budget - totalAllocated;
										// Validate the new project budget
										if(input.Allocated_Project_Budget > remainingBudget)
										{
											alert "Project budget exceeds the department's remaining quarterly budget. Remaining Budget available for the department is " + remainingBudget;
											cancel submit;
										}
						)
					}
				}

			}
			Update_Resource_Configura as "Update Resource Configuration Choices"
			{
				type =  form
				form = Cloud_Resource_Registry

				record event = on add or edit

				on user input of Resource_Type
				{
					actions 
					{
						custom deluge script
						(
											input.Hourly_Cost = null;
										if(input.Resource_Type == "EC2 Compute Instance")
										{
											options = List();
											options.add("t3.micro");
											options.add("t3.large");
											options.add("m5.2xlarge");
											input.Instance_Size_Tier:ui.add(options);
										}
										else if(input.Resource_Type == "RDS Database")
										{
											options = List();
											options.add("db.r5.large");
											options.add("db.r5.xlarge");
											input.Instance_Size_Tier:ui.add(options);
										}
										else if(input.Resource_Type == "S3 Storage Bucket")
										{
											options = List();
											options.add("S3 Standard - 50 GB");
											options.add("S3 Standard - 100 GB");
											options.add("S3 Standard - 500 GB");
											input.Instance_Size_Tier:ui.add(options);
										}
										else if(input.Resource_Type == "Kubernetes Cluster")
										{
											options = List();
											options.add("EKS - Small");
											options.add("EKS - Medium");
											options.add("EKS - Large");
											input.Instance_Size_Tier:ui.add(options);
										}
						)
					}
				}

			}
		}

		schedule
		{
			Weekly_Idle_Resource_Swee as "Weekly Idle Resource Sweeper"
			{
				type =  schedule
					status = inactive
				start = "2026-10-16 20:00:00"
				frequency = weekly
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all active resources with CPU utilization below 5%
										idleAssets = Cloud_Resource_Registry[Idle_CPU_Utilization < 5.0 && Resource_Lifecycle_Status == "Running" && Resource_Type != "S3 Storage Bucket"];
										for each  asset in idleAssets
										{
											// Calculate estimated waste saved (Assuming 120 idle hours logged)
											wasteSaved = asset.Hourly_Cost * 120;
											// Update asset lifecycle status
											asset.Resource_Lifecycle_Status="Idle";
											// Create an audit entry in Resource_Cleanup_Logs without commas
											insert into Resource_Cleanup_Logs
											[
												Resource_Name=asset.ID
												Project_Name=asset.Project_Name.Project_Name
												Wasted_Dollars_Saved=wasteSaved
												Action_Taken="Developer Notified"
												Execution_Time_Stamp=zoho.currenttime
												Added_User=zoho.loginuser
											]
										}
					)
					}
				}
			}
		}

		approval
		{
			Resource_Requisition_Appr as "Resource Requisition Approval"
			{
				type =  approval
				form = Cloud_Resource_Requisition
				display fields = [Requisition_ID,Project_Name,Name_Of_Requested_Person,E_mail,Requested_Instance_Tier,Justification,Estimated_Monthly_Cost]
				on start
				{
				}
				on level 1
				{
					approvers
					(
			 			role = "Manager"
					)
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
						actions 
						{
						update Cloud_Resource_Requisition[ID == input.ID]
						[
							Approval_Status = "Approved"
						]
						}
						actions 
						{
						on load
						(
							// DS-04: Register resource after Manager approval
												hRate = 0.0;
												// Calculate hourly cost
												if(input.Requested_Instance_Tier == "t3.micro")
												{
													hRate = 0.0104;
												}
												else if(input.Requested_Instance_Tier == "t3.large")
												{
													hRate = 0.0832;
												}
												else if(input.Requested_Instance_Tier == "m5.2xlarge")
												{
													hRate = 0.3840;
												}
												// Generate resource ID from requisition ID
												resID = "i-auto-" + input.Requisition_ID.toString();
												// Check for an existing resource
												existingResource = Cloud_Resource_Registry[Resource_ID == resID];
												if(existingResource.ID == null)
												{
													insert into Cloud_Resource_Registry
													[
														Resource_ID=resID
														Project_Name=input.Project_Name
														Resource_Type="EC2 Compute Instance"
														Instance_Size_Tier=input.Requested_Instance_Tier
														Hourly_Cost=hRate
														Idle_CPU_Utilization=100.0
														Resource_Lifecycle_Status="Running"
														Added_User=zoho.loginuser
													]
													info "Resource registered successfully.";
												}
												else
												{
													info "Resource is already registered.";
												}
						)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
						actions 
						{
						update Cloud_Resource_Requisition[ID == input.ID]
						[
							Approval_Status = "Rejected"
						]
						}
					}
				}
			}
		}



		functions
		{
			Stop_Idle_Instance as "Stop Idle Instance"
			{
				type =  functions
				form = Cloud_Resource_Registry
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						selectedRecord = Cloud_Resource_Registry[ID == input.ID];
										if(selectedRecord != null && selectedRecord.Resource_Lifecycle_Status == "Idle")
										{
											thisapp.Stop_Idle_Instance(selectedRecord.ID);
											info "Resource termination processed successfully.";
										}
										else
										{
											info "Selected resource is not Idle or does not exist.";
										}
					)
					}
				}
			}
			Test_Stop_Function as "Test Stop Function"
			{
				type =  functions
				form = Cloud_Resource_Registry
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						selectedRecord = Cloud_Resource_Registry[ID == input.ID];
										if(selectedRecord.ID != null)
										{
											thisapp.Stop_Idle_Instance(selectedRecord.ID);
										}
					)
					}
				}
			}
		}
	}
